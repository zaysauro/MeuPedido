# Configure only in Vercel or your local .env.local; never commit credentials.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
BETTER_AUTH_SECRET=generate_a_random_32_byte_secret
BETTER_AUTH_URL=http://localhost:3000
# Exact hostname from DATABASE_URL; prevents using the wrong Neon branch.
EXPECTED_DATABASE_HOST=host
# Keep billing disabled during operational validation.
BILLING_ENFORCED=false
# Optional: verified sender and Resend key for actual recovery emails.
# RESEND_API_KEY=
# EMAIL_FROM=
REQUIRE_EMAIL_VERIFICATION=false
